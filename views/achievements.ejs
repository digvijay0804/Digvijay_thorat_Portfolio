<!-- Certificate Image CSS -->
<style>

.certificate-image-container {
    width: 100%;
    height: 280px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: 15px;
    background: #ffffff;
}

.certificate-image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    border-radius: 10px;
    transition: transform 0.3s ease;
}

.certificate-image:hover {
    transform: scale(1.03);
}

</style>