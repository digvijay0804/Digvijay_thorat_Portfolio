                    <div class="card-body p-4">

                        <h3 class="skill-title slide-in-left">
                            <i class="fas fa-toolbox me-2"></i>
                            Development Tools
                        </h3>

                        <div class="skill-badge-container mt-3">
                            <span class="skill-badge">VS Code</span>
                            <span class="skill-badge">GitHub</span>
                            <span class="skill-badge">AWS CLI</span>
                            <span class="skill-badge">CMD</span>
