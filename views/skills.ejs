                            <span class="skill-badge">Minikube</span>
                            <span class="skill-badge">Kind</span>
                        </div>

                    </div>
                </div>
            </div>
        </div>

        <!-- Infrastructure as Code -->
        <div class="col-md-6 mb-4">
            <div class="skill-card animate-on-scroll">
                <div class="card shadow-lg">
                    <div class="card-body p-4">

                        <h3 class="skill-title slide-in-left">
                            <i class="fas fa-code-branch me-2"></i>
                            Infrastructure as Code
                        </h3>

                        <div class="skill-badge-container mt-3">
                            <span class="skill-badge">Terraform</span>
                            <span class="skill-badge">AWS Infrastructure</span>
                            <span class="skill-badge">VPC</span>
                            <span class="skill-badge">EC2</span>
                            <span class="skill-badge">Security Groups</span>
                        </div>

                    </div>
                </div>
            </div>
        </div>

        <!-- Linux -->
        <div class="col-md-6 mb-4">
            <div class="skill-card animate-on-scroll">
                <div class="card shadow-lg">
                    <div class="card-body p-4">

                        <h3 class="skill-title slide-in-left">
                            <i class="fab fa-linux me-2"></i>
                            Linux & System Administration
                        </h3>

                        <div class="skill-badge-container mt-3">
