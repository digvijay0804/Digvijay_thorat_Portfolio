<% layout('boilerplate') -%>

<div class="container my-5">

    <h2 class="section-title text-center mb-5 fade-in">
        <span class="title-black">Technical</span> Skills
    </h2>

    <div class="row">

        <!-- Cloud & AWS -->
        <div class="col-md-12 mb-4">
            <div class="skill-card animate-on-scroll">
                <div class="card shadow-lg">
                    <div class="card-body p-4">

                        <h3 class="skill-title slide-in-left">
                            <i class="fas fa-cloud me-2"></i>
                            Cloud & AWS
                        </h3>

                        <div class="skill-badge-container mt-3">
                            <span class="skill-badge">AWS</span>
                            <span class="skill-badge">EC2</span>
                            <span class="skill-badge">S3</span>
                            <span class="skill-badge">CloudFront</span>
                            <span class="skill-badge">Route 53</span>
                            <span class="skill-badge">RDS</span>
                            <span class="skill-badge">ECR</span>
                            <span class="skill-badge">ECS</span>
                            <span class="skill-badge">EKS</span>
                            <span class="skill-badge">IAM</span>
                            <span class="skill-badge">AWS CLI</span>
                        </div>

                    </div>
                </div>
            </div>
        </div>

        <!-- DevOps & CI/CD -->
        <div class="col-md-6 mb-4">
            <div class="skill-card animate-on-scroll">
                <div class="card shadow-lg">
                    <div class="card-body p-4">

                        <h3 class="skill-title slide-in-left">
                            <i class="fas fa-gears me-2"></i>
                            DevOps & CI/CD
                        </h3>

                        <div class="skill-badge-container mt-3">
                            <span class="skill-badge">Git</span>
                            <span class="skill-badge">GitHub</span>
                            <span class="skill-badge">GitHub Actions</span>
                            <span class="skill-badge">CI/CD</span>
                            <span class="skill-badge">Shell Scripting</span>
                        </div>

                    </div>
                </div>
            </div>
        </div>

        <!-- Containers -->
        <div class="col-md-6 mb-4">
            <div class="skill-card animate-on-scroll">
                <div class="card shadow-lg">
                    <div class="card-body p-4">

                        <h3 class="skill-title slide-in-left">
                            <i class="fab fa-docker me-2"></i>
                            Containerization
                        </h3>

                        <div class="skill-badge-container mt-3">
                            <span class="skill-badge">Docker</span>
                            <span class="skill-badge">Dockerfile</span>
                            <span class="skill-badge">Docker Compose</span>
                            <span class="skill-badge">Docker Hub</span>
                            <span class="skill-badge">Container Networking</span>
                            <span class="skill-badge">Volumes</span>
                        </div>

                    </div>
                </div>
            </div>
        </div>

        <!-- Kubernetes -->
        <div class="col-md-6 mb-4">
            <div class="skill-card animate-on-scroll">
                <div class="card shadow-lg">
                    <div class="card-body p-4">

                        <h3 class="skill-title slide-in-left">
                            <i class="fas fa-dharmachakra me-2"></i>
                            Kubernetes
                        </h3>

                        <div class="skill-badge-container mt-3">
                            <span class="skill-badge">Kubernetes</span>
                            <span class="skill-badge">Pods</span>
                            <span class="skill-badge">Deployments</span>
                            <span class="skill-badge">Services</span>
                            <span class="skill-badge">ConfigMaps</span>
                            <span class="skill-badge">Secrets</span>
                            <span class="skill-badge">Ingress</span>
