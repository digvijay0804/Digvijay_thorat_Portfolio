                            <span class="skill-badge">Bash</span>
                            <span class="skill-badge">SSH</span>
                            <span class="skill-badge">Systemctl</span>
                            <span class="skill-badge">Cron Jobs</span>
                            <span class="skill-badge">File Permissions</span>
                            <span class="skill-badge">Process Management</span>
                        </div>

                    </div>
                </div>
            </div>
        </div>

        <!-- Networking -->
        <div class="col-md-12 mb-4">
            <div class="skill-card animate-on-scroll">
                <div class="card shadow-lg">
                    <div class="card-body p-4">

                        <h3 class="skill-title slide-in-left">
                            <i class="fas fa-network-wired me-2"></i>
                            Networking
                        </h3>

                        <div class="skill-badge-container mt-3">
                            <span class="skill-badge">OSI Model</span>
                            <span class="skill-badge">TCP/IP</span>
                            <span class="skill-badge">HTTP/HTTPS</span>
                            <span class="skill-badge">DNS</span>
                            <span class="skill-badge">DHCP</span>
                            <span class="skill-badge">NAT</span>
                            <span class="skill-badge">IPv4</span>
                            <span class="skill-badge">IPv6</span>
                            <span class="skill-badge">Ping</span>
                            <span class="skill-badge">Traceroute</span>
                            <span class="skill-badge">nslookup</span>
                            <span class="skill-badge">curl</span>
                            <span class="skill-badge">ss</span>
                            <span class="skill-badge">netstat</span>
                        </div>

                    </div>
                </div>
            </div>
        </div>

        <!-- Programming & Scripting -->
        <div class="col-md-6 mb-4">
            <div class="skill-card animate-on-scroll">
                <div class="card shadow-lg">
                    <div class="card-body p-4">

