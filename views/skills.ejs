        <div class="col-md-12 mb-4">
            <div class="skill-card animate-on-scroll">
                <div class="card shadow-lg">
                    <div class="card-body p-4">

                        <h3 class="skill-title slide-in-left">
                            <i class="fas fa-book me-2"></i>
                            Relevant Coursework
                        </h3>

                        <div class="row">

                            <div class="col-md-3">
                                <div class="course-item">
                                    <h5 class="course-title">Operating Systems</h5>
                                    <p class="course-description">
                                        Linux, processes, memory and system management
                                    </p>
                                </div>
                            </div>

                            <div class="col-md-3">
                                <div class="course-item">
                                    <h5 class="course-title">Computer Networks</h5>
                                    <p class="course-description">
                                        TCP/IP, DNS, HTTP, networking fundamentals
                                    </p>
                                </div>
                            </div>

                            <div class="col-md-3">
                                <div class="course-item">
                                    <h5 class="course-title">DBMS</h5>
                                    <p class="course-description">
                                        MySQL, MongoDB and database fundamentals
                                    </p>
                                </div>
                            </div>

                            <div class="col-md-3">
                                <div class="course-item">
                                    <h5 class="course-title">Cloud Computing</h5>
                                    <p class="course-description">
                                        AWS cloud services and deployment concepts
                                    </p>
                                </div>
                            </div>

                        </div>

                    </div>
                </div>
            </div>
        </div>

