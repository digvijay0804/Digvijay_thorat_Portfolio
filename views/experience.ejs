<% layout('boilerplate') -%>

<div class="container my-5">

    <h2 class="section-title text-center mb-5 fade-in">
        <span class="title-black">Professional</span> Experience
    </h2>

    <div class="row justify-content-center">

        <!-- ===================================================== -->
        <!-- CODEALPHA EXPERIENCE -->
        <!-- ===================================================== -->

        <div class="col-md-8 mb-4">
            <div class="experience-card animate-on-scroll">

                <div class="card shadow-lg">

                    <!-- CodeAlpha Image -->
                    <div class="experience-image-container">

                        <img src="codealpha.jpg"
                             alt="CodeAlpha Logo"
                             class="experience-image">

                        <div class="experience-overlay">
                            <div class="overlay-content">
                                <span class="year-badge">
                                    Aug – Sep 2026
                                </span>
                            </div>
                        </div>

                    </div>


                    <!-- CodeAlpha Content -->
                    <div class="card-body p-4">

                        <h3 class="experience-title slide-in-left">
                            DevOps Intern
                        </h3>


                        <div class="company-info mb-3">

                            <span class="company-badge">
                                CodeAlpha
                            </span>

                            <span class="date-badge">
                                Aug 2026 – Sep 2026
                            </span>

                        </div>


                        <div class="achievement-box">

                            <ul class="feature-list">

                                <li>
                                    <i class="fas fa-check-circle"></i>
                                    Worked on practical DevOps tasks involving
                                    CI/CD pipelines, Docker and automation.
                                </li>

                                <li>
                                    <i class="fas fa-check-circle"></i>
                                    Worked with Jenkins and Git-based workflows
                                    for continuous integration and deployment.
                                </li>

                                <li>
                                    <i class="fas fa-check-circle"></i>
                                    Gained hands-on experience with containerized
                                    applications and DevOps practices.
                                </li>

                                <li>
                                    <i class="fas fa-check-circle"></i>
                                    Practiced cloud and deployment concepts using
                                    modern DevOps tools.
                                </li>

                            </ul>

                        </div>

                    </div>

                </div>

            </div>
        </div>



        <!-- ===================================================== -->
        <!-- CLIQTROS EXPERIENCE -->
        <!-- ===================================================== -->

        <div class="col-md-8 mb-4">
            <div class="experience-card animate-on-scroll">

                <div class="card shadow-lg">

                    <!-- Cliqtros Image -->
                    <div class="experience-image-container">

                        <img src="cliqtros.png"
                             alt="Cliqtros Solutions Logo"
                             class="experience-image">

                        <div class="experience-overlay">
                            <div class="overlay-content">
                                <span class="year-badge">
                                    Sep 2026 – Present
                                </span>
                            </div>
                        </div>

                    </div>


                    <!-- Cliqtros Content -->
                    <div class="card-body p-4">

                        <h3 class="experience-title slide-in-left">
                            Cloud &amp; DevOps / Software Developer
                        </h3>


                        <div class="company-info mb-3">

                            <span class="company-badge">
                                Cliqtros Solutions
                            </span>

                            <span class="date-badge">
                                Sep 2026 – Present
                            </span>

                        </div>


                        <div class="achievement-box">

                            <ul class="feature-list">

                                <li>
                                    <i class="fas fa-check-circle"></i>
                                    Worked on Angular-based web application
                                    development and responsive UI improvements.
                                </li>

                                <li>
                                    <i class="fas fa-check-circle"></i>
                                    Integrated REST APIs using Angular services
                                    and worked with .NET backend APIs.
                                </li>

                                <li>
                                    <i class="fas fa-check-circle"></i>
                                    Worked on the Subscription module UI and
                                    integrated it into the main TOT application.
                                </li>

                                <li>
                                    <i class="fas fa-check-circle"></i>
                                    Worked with Git and GitHub for source-code
                                    management and project collaboration.
                                </li>

                                <li>
                                    <i class="fas fa-check-circle"></i>
                                    Gained practical experience with Docker,
                                    containerized applications and CI/CD concepts.
                                </li>

                                <li>
                                    <i class="fas fa-check-circle"></i>
                                    Practiced AWS cloud services, deployment and
                                    cloud-native application concepts.
                                </li>

                                <li>
                                    <i class="fas fa-check-circle"></i>
                                    Worked with Cloud and DevOps practices for
                                    application deployment and development workflows.
                                </li>

                                <li>
                                    <i class="fas fa-check-circle"></i>
                                    Created technical documentation for implemented
                                    features and project changes.
                                </li>

                            </ul>

                        </div>

                    </div>

                </div>

            </div>
        </div>

    </div>



    <!-- ===================================================== -->
    <!-- NEXT PAGE -->
    <!-- ===================================================== -->

    <div class="next-section-nav">

        <a href="/<%= nextPage %>" class="next-page-btn">

            <%= nextPageTitle %>

            <i class="fas fa-arrow-right"></i>

        </a>

    </div>

</div>



<!-- ========================================================= -->
<!-- EXPERIENCE STYLES -->
<!-- ========================================================= -->

<style>

.experience-image-container {
    position: relative;
    width: 100%;
    height: 250px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
}

.experience-image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 20px;
}

.experience-overlay {
    position: absolute;
    top: 0;
    right: 0;
    padding: 15px;
}

.overlay-content {
    display: flex;
    align-items: center;
    justify-content: center;
}

.year-badge {
    padding: 8px 18px;
    border-radius: 20px;
    font-weight: 700;
    font-size: 14px;
    white-space: nowrap;
}

.company-info {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
}

.company-badge,
.date-badge {
    display: inline-block;
    padding: 6px 14px;
    border-radius: 20px;
    font-weight: 600;
    font-size: 14px;
}

.achievement-box {
    margin-top: 15px;
}

.feature-list {
    padding-left: 0;
    margin-bottom: 0;
    list-style: none;
}

.feature-list li {
    margin-bottom: 12px;
    line-height: 1.6;
}

.feature-list li i {
    margin-right: 8px;
}

.experience-title {
    margin-bottom: 12px;
    font-weight: 700;
}

</style>