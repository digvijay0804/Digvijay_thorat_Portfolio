<style>

.project-card {
    transition: transform 0.3s ease;
}

.project-card:hover {
    transform: translateY(-6px);
}

.project-wrapper {
    overflow: hidden;
    border: none;
    border-radius: 18px;
}

.project-image {
    position: relative;
    height: 280px;
    overflow: hidden;
    background: #111827;
}

.project-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
}

.project-card:hover .project-img {
    transform: scale(1.05);
}

.project-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    background: rgba(0, 0, 0, 0.55);
    opacity: 0;
    transition: opacity 0.3s ease;
}

.project-card:hover .project-overlay {
    opacity: 1;
}

.project-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 11px 22px;
    background: #ff4500;
    color: white;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 600;
    transition: all 0.3s ease;
}

.project-btn:hover {
    background: #e63e00;
    color: white;
    text-decoration: none;
    transform: translateY(-2px);
}

.project-content {
    padding: 28px;
}

.project-title {
    font-size: 1.6rem;
    font-weight: 700;
    margin-bottom: 12px;
}

.tech-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 15px 0;
}

.tech-badge {
    padding: 6px 12px;
    border-radius: 20px;
    background: #fff1eb;
    color: #ff4500;
    border: 1px solid #ff4500;
    font-size: 0.85rem;
    font-weight: 600;
}

.project-description {
    line-height: 1.7;
    margin-bottom: 20px;
}

.features-section h5 {
    font-weight: 700;
    margin-bottom: 12px;
}

.feature-list {
    padding-left: 0;
    list-style: none;
    margin-bottom: 0;
}

.feature-list li {
    margin-bottom: 10px;
}

.feature-list i {
    color: #ff4500;
    margin-right: 8px;
}

@media (max-width: 768px) {

    .project-image {
        height: 210px;
    }

    .project-content {
        padding: 20px;
    }

    .project-title {
        font-size: 1.35rem;
    }

}

</style>