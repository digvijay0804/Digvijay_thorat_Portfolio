<% layout('boilerplate') -%>

<div class="animated-background"></div>

<div class="container my-5">

    <div class="row align-items-center justify-content-center">

        <div class="col-md-10">

            <!-- Hero Section -->
            <div class="intro-header text-center mb-5 animate-on-scroll">

                <h1 class="mega-title fade-in"
                    style="font-size: clamp(2.5rem, 5vw, 3.5rem);">

                    <span style="
                        background: linear-gradient(45deg, #ff4500, #ff8c5a);
                        -webkit-background-clip: text;
                        -webkit-text-fill-color: transparent;
                        font-weight: 800;">
                        Hey ,
                    </span>

                    <span style="color: #000000; font-weight: 800;">
                        I'm
                    </span>

                    <span class="highlight-name"
                        style="
                        color: var(--dark-orange);
                        font-weight: 900 !important;
                        text-shadow: 1px 0 0 var(--dark-orange);
                        letter-spacing: 0.5px;">
                        Digvijay Thorat
                    </span>

                    <span class="waving-hand">
                        👋
                    </span>

                </h1>


                <!-- Role -->
                <div class="role-container slide-in-up"
                    style="margin-top: 2rem;">

                    <h2 class="role-title"
                        style="
                        display: flex;
                        gap: 1rem;
                        justify-content: center;
                        align-items: center;
                        flex-wrap: wrap;">

                        <span class="role-badge">
                            Cloud & DevOps Engineer
                        </span>

                        <span class="role-divider">|</span>

                        <span class="role-badge">
                            AWS Enthusiast
                        </span>

                    </h2>

                </div>


                <!-- Resume Download Button -->
                <div class="resume-button-container text-center mt-4">

                    <a href="/resume.pdf"
                       download="Digvijay_Thorat_Resume.pdf"
                       class="resume-btn">

                        <i class="fas fa-file-download"></i>
                        Download Resume

                    </a>

                </div>

            </div>


            <!-- Profile Card -->
            <div class="profile-card p-4 animate-on-scroll">

                <div class="row align-items-center">


                    <!-- Profile Image -->
                    <div class="col-md-4 text-center mb-4 mb-md-0">

                        <div class="profile-image-container mb-3">

                            <img src="profile.jpg"
                                 alt="Digvijay Thorat"
                                 class="profile-image">

                        </div>


                        <!-- Social Links -->
                        <div class="social-links bounce-in">


                            <!-- GitHub -->
                            <a href="https://github.com/digvijay0804"
                               target="_blank"
                               class="social-btn pulse"
                               aria-label="GitHub">

                                <i class="fab fa-github"></i>

                            </a>


                            <!-- LinkedIn -->
                            <a href="https://www.linkedin.com/in/digvijay-thorat-460bab348/"
                               target="_blank"
                               class="social-btn pulse"
                               aria-label="LinkedIn">

                                <i class="fab fa-linkedin-in"></i>

                            </a>


                            <!-- WhatsApp -->
                            <a href="https://wa.me/919112806323"
                               target="_blank"
                               class="social-btn pulse"
                               aria-label="WhatsApp">

                                <i class="fab fa-whatsapp"></i>

                            </a>


                            <!-- Email -->
                            <a href="mailto:digvijaythorat855@gmail.com"
                               class="social-btn pulse"
                               aria-label="Email">

                                <i class="fas fa-envelope"></i>

                            </a>

                        </div>

                    </div>


                    <!-- About Content -->
                    <div class="col-md-8">

                        <div class="profile-content fade-in">

                            <div class="about-section fade-in-up">


                                <p class="about-text">

                                    I am a Cloud & DevOps Engineer focused on
                                    building, deploying and automating
                                    cloud-native applications using AWS and
                                    modern DevOps tools.

                                </p>


                                <p class="about-text highlight-text">

                                    I have hands-on experience with Docker,
                                    Kubernetes, Terraform, Git, GitHub Actions,
                                    Prometheus, Grafana, Linux and AWS services.

                                </p>


                                <p class="about-text">

                                    I enjoy automating deployment workflows,
                                    building CI/CD pipelines and working with
                                    containerized applications. I am continuously
                                    learning new technologies and looking for
                                    opportunities to grow as a DevOps Engineer.

                                </p>


                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- Next Section -->
    <div class="next-section-nav">

        <a href="/<%= nextPage %>"
           class="next-page-btn">

            <%= nextPageTitle %>

            <i class="fas fa-arrow-right"></i>

        </a>

    </div>

</div>


<!-- Resume Button Styling -->
<style>

.resume-button-container {
    margin-top: 25px;
}

.resume-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 12px 25px;
    background: linear-gradient(45deg, #ff4500, #ff8c5a);
    color: #ffffff;
    text-decoration: none;
    font-weight: 700;
    border-radius: 10px;
    transition: all 0.3s ease;
    box-shadow: 0 5px 15px rgba(255, 69, 0, 0.25);
}

.resume-btn:hover {
    color: #ffffff;
    text-decoration: none;
    transform: translateY(-3px);
    box-shadow: 0 8px 20px rgba(255, 69, 0, 0.35);
}

.resume-btn i {
    font-size: 18px;
}

</style>