<% layout('boilerplate') -%>

<div class="container my-5">
    <h2 class="section-title text-center mb-5 fade-in">
        <span class="title-black">Academic</span> Journey
    </h2>


<div class="education-timeline">

    <!-- M.Sc. Computer Science -->
    <div class="education-card animate-on-scroll mb-5">
        <div class="card shadow-lg">
            <div class="row g-0 align-items-center">

                <div class="col-md-8 order-md-1">
                    <div class="card-body p-4">

                        <h3 class="education-title slide-in-left">
                            M.Sc. Computer Science
                        </h3>

                        <div class="school-info mb-3">
                            <span class="education-badge">
                                Bharati Vidyapeeth, Pune
                            </span>
                            <span class="education-badge">
                                Computer Science
                            </span>
                            <span class="education-badge">
                                2025 - Present
                            </span>
                        </div>

                        <div class="achievement-box mt-3">
                            <div class="percentage-wrapper">
                                <h5 class="mb-3">
                                    Postgraduate Studies
                                </h5>

                                <p>
                                    Currently pursuing M.Sc. in Computer Science
                                    with a focus on Cloud Computing, DevOps,
                                    software development and modern technologies.
                                </p>
                            </div>
                        </div>

                    </div>
                </div>

                <div class="col-md-4 order-md-2">
                    <div class="education-image-container">
                        <img src="photo.jpg"
                             class="img-fluid"
                             alt="Bharati Vidyapeeth Pune">

                        <div class="education-overlay">
                            <div class="overlay-content">
                                <span class="year-badge">
                                    2025 - Present
                                </span>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>


    <!-- B.Sc. Computer Science -->
    <div class="education-card animate-on-scroll mb-5">
        <div class="card shadow-lg">
            <div class="row g-0 align-items-center">

                <div class="col-md-8 order-md-1">
                    <div class="card-body p-4">

                        <h3 class="education-title slide-in-left">
                            Bachelor of Computer Science
                        </h3>

                        <div class="school-info mb-3">
                            <span class="education-badge">
                                S.G.M. College, Karad
                            </span>
                            <span class="education-badge">
                                Shivaji University, Kolhapur
                            </span>
                            <span class="education-badge">
                                2022 - 2025
                            </span>
                        </div>

                        <div class="achievement-box mt-3">
                            <div class="percentage-wrapper">
                                <h5 class="mb-3">
                                    Academic Performance
                                </h5>

                                <div class="progress-container">
                                    <div class="progress" style="height: 10px;">
                                        <div class="progress-bar"
                                             role="progressbar"
                                             style="width: 70%;"
                                             aria-valuenow="70"
                                             aria-valuemin="0"
                                             aria-valuemax="100">
                                        </div>
                                    </div>

                                    <span class="percentage-label">
                                        70%
                                    </span>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>

                <div class="col-md-4 order-md-2">
                    <div class="education-image-container">
                        <img src="sgm.jpg"
                             class="img-fluid"
                             alt="S.G.M. College Karad">

                        <div class="education-overlay">
                            <div class="overlay-content">
                                <span class="year-badge">
                                    2022 - 2025
                                </span>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>


    <!-- 12th Grade -->
    <div class="education-card animate-on-scroll mb-5">
        <div class="card shadow-lg">
            <div class="row g-0 align-items-center">

                <div class="col-md-8 order-md-1">
                    <div class="card-body p-4">

                        <h3 class="education-title slide-in-left">
                            12th Grade
                        </h3>

                        <div class="school-info mb-3">
                            <span class="education-badge">
                                Higher Secondary Education
                            </span>
                            <span class="education-badge">
                                Maharashtra State Board
                            </span>
                            <span class="education-badge">
                                2022
                            </span>
                        </div>

                        <div class="achievement-box mt-3">
                            <div class="percentage-wrapper">

                                <h5 class="mb-3">
                                    Academic Performance
                                </h5>

                                <div class="progress-container">
                                    <div class="progress" style="height: 10px;">
                                        <div class="progress-bar"
                                             role="progressbar"
                                             style="width: 72.33%;"
                                             aria-valuenow="72.33"
                                             aria-valuemin="0"
                                             aria-valuemax="100">
                                        </div>
                                    </div>

                                    <span class="percentage-label">
                                        72.33%
                                    </span>
                                </div>

                            </div>
                        </div>

                    </div>
                </div>

                <div class="col-md-4 order-md-2">
                    <div class="education-image-container">

                        <img src="12.jpg"
                             class="img-fluid"
                             alt="12th Grade">

                        <div class="education-overlay">
                            <div class="overlay-content">
                                <span class="year-badge">
                                    2022
                                </span>
                            </div>
                        </div>

                    </div>
                </div>

            </div>
        </div>
    </div>


    <!-- 10th Grade -->
    <div class="education-card animate-on-scroll mb-5">
        <div class="card shadow-lg">
            <div class="row g-0 align-items-center">

                <div class="col-md-8 order-md-1">
                    <div class="card-body p-4">

                        <h3 class="education-title slide-in-left">
                            10th Grade
                        </h3>

                        <div class="school-info mb-3">
                            <span class="education-badge">
                                Secondary Education
                            </span>
                            <span class="education-badge">
                                Maharashtra State Board
                            </span>
                            <span class="education-badge">
                                2020
                            </span>
                        </div>

                        <div class="achievement-box mt-3">
                            <div class="percentage-wrapper">

                                <h5 class="mb-3">
                                    Academic Performance
                                </h5>

                                <div class="progress-container">
                                    <div class="progress" style="height: 10px;">
                                        <div class="progress-bar"
                                             role="progressbar"
                                             style="width: 77.60%;"
                                             aria-valuenow="77.60"
                                             aria-valuemin="0"
                                             aria-valuemax="100">
                                        </div>
                                    </div>

                                    <span class="percentage-label">
                                        77.60%
                                    </span>
                                </div>

                            </div>
                        </div>

                    </div>
                </div>

                <div class="col-md-4 order-md-2">
                    <div class="education-image-container">

                        <img src="10.jpg"
                             class="img-fluid"
                             alt="10th Grade">

                        <div class="education-overlay">
                            <div class="overlay-content">
                                <span class="year-badge">
                                    2020
                                </span>
                            </div>
                        </div>

                    </div>
                </div>

            </div>
        </div>
    </div>

</div>

<div class="next-section-nav">
    <a href="/<%= nextPage %>" class="next-page-btn">
        <%= nextPageTitle %>
        <i class="fas fa-arrow-right"></i>
    </a>
</div>


</div>
